# Variables de entorno para Producción (fiechero .env.production)
# Común
NODE_ENV=production
CORS_ALLOWED_ORIGIN=http://10.1.,http://172.,http://192.168.

# Para backend
# Old Database Configuration (mysql)
DB_OLD_HOST=mysql
DB_OLD_PORT=3306
DB_OLD_USERNAME=dbuser
DB_OLD_PASSWORD=userpassword
DB_OLD_DATABASE=cuadrantes

# New Database Configuration (mariadb)
DB_NEW_HOST=mariadb
DB_NEW_PORT=3306
DB_NEW_USERNAME=dbuser
DB_NEW_PASSWORD=dbpassword
DB_NEW_DATABASE=cuadrantes2

# Server configuration
HOST=http://api
PORT=3101
GESTION_PORT=3002

#App Configuration
JWT_SECRET=ESTE_ES_UN_SECRETO_MUY_LARGO_Y_SEGURO_CAMBIAME
JWT_EXPIRATION=3600s # 1 hora

# Para Frontend
APP_PORT=3002
APP_URL=http://gestion
NEXT_PUBLIC_API_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3101
API_URL_SERVER_SIDE=http://api:3000
NEXT_PUBLIC_LOGO_FILENAME=local-img-logo-orden-trabajo.jpg

# Email Configuration (SMTP)
# Configura estas variables con tus credenciales de SMTP en producción
# Para Gmail o servicios con TLS en puerto 587: SMTP_SECURE=false
# Para servicios con SSL en puerto 465: SMTP_SECURE=true
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-email-produccion@empresa.com
SMTP_PASSWORD=tu-contraseña-app-produccion
SMTP_FROM="Cuadrantes <notificaciones@empresa.com>"


# .env.production.local -> for production use

# Old Database Configuration (mysql)
DB_OLD_HOST=db-old
DB_OLD_PORT=3305
DB_OLD_USERNAME=user
DB_OLD_PASSWORD=password
DB_OLD_DATABASE=db

# New Database Configuration (mariadb)
DB_NEW_HOST=db-new
DB_NEW_PORT=3306
DB_NEW_USERNAME=root
DB_NEW_PASSWORD=password
DB_NEW_DATABASE=cuadrantes2

# Server configuration
HOST=0.0.0.0
PORT=3101
GESTION_PORT=3002
CORS_ALLOWED_ORIGIN=https://tu-dominio.com,https://www.tu-dominio.com

# App Configuration
JWT_SECRET=CAMBIA_ESTO_POR_TU_SECRETO_LARGO_Y_COMPLEJO_EN_PRODUCCION
JWT_EXPIRATION=3600s

# Email Configuration (SMTP)
# Configura estas variables con tus credenciales de SMTP en producción
# Para Gmail o servicios con TLS en puerto 587: SMTP_SECURE=false
# Para servicios con SSL en puerto 465: SMTP_SECURE=true
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-email-produccion@empresa.com
SMTP_PASSWORD=tu-contraseña-app-produccion
SMTP_FROM="Cuadrantes <notificaciones@empresa.com>"

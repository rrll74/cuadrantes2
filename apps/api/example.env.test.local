# .env.test.local for testing environment

# Variables de entorno para los tests E2E
E2E_DB_PATH=./test.sqlite
E2E_ADMIN_PASSWORD=supersecretadminpass
E2E_USER_PASSWORD=supersecretuserpass

# Variables para JWT, necesarias para que el módulo de Auth se inicie
JWT_SECRET=a-very-secret-key-for-testing
JWT_EXPIRATION=15m

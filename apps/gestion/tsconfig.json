{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    // Esta opción es CRUCIAL cuando se usa "moduleResolution": "bundler".
    // Permite importar archivos que no terminan en .ts o .tsx (como .css)
    // y que TypeScript encuentre sus declaraciones de tipo (en types.d.ts).
    "allowImportingTsExtensions": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    // IMPORTANTE: Asegúrate de que "cypress" no esté en la lista.
    // "jest" y "node" son buenas prácticas para el entorno de testing unitario.
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    ".storybook/**/*.ts",
    "**/*.d.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "jest.setup.ts",
    "../api/src/newdatabase/jornadas/entities/presence-result.entity.ts",
    "../api/src/newdatabase/jornadas/entities/import-session.entity.ts",
    "../api/src/newdatabase/jornadas/entities/raw-clock-in.entity.ts",
    "../api/src/newdatabase/jornadas/entities/raw-worker.entity.ts",
    "../api/src/newdatabase/jornadas/entities/scheduled-route.entity.ts"
  ],
  "exclude": ["node_modules"]
}

{
  "compilerOptions": {
    "target": "es2021",
    "module": "commonjs",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // No incluir tipos específicos de frameworks en la config base
    // Cada app (api, gestion) configura sus propios tipos
    "types": ["node"]
  }
}

{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Iniciar Chrome para localhost",
      "request": "launch",
      "url": "http://localhost:3002",
      "type": "chrome",
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to NestJS API",
      "port": 9229,
      "restart": { "delay": 5000, "maxAttempts": 36 },
      "sourceMaps": true,
      "cwd": "${workspaceFolder}/apps/api",
      "outFiles": ["${workspaceFolder}/apps/api/dist/**/*.js"],
      "skipFiles": ["<node_internals>/**", "node_modules/**"],
      "sourceMapPathOverrides": {
        // Esto es crucial para que VS Code encuentre tus archivos .ts originales
        // cuando la aplicación se ejecuta desde el directorio 'dist'.
        "webpack:///./src/*": "${workspaceFolder}/apps/api/src/*"
      }
    }
  ]
}

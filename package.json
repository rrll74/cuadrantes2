{
  "name": "cuadrantes2-monorepo",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel watch:shared dev:api dev:gestion",
    "dev:api": "npm run -w apps/api start:dev",
    "dev:gestion": "npm run -w apps/gestion dev",
    "build": "npm-run-all -s build:shared build:api build:gestion",
    "build:shared": "npm run -w @cuadrantes/shared-dto build",
    "build:api": "npm run -w apps/api build",
    "build:gestion": "npm run -w apps/gestion build",
    "watch:shared": "npm run -w @cuadrantes/shared-dto watch",
    "start:api": "npm run -w apps/api start:prod",
    "start:gestion": "npm run -w apps/gestion start",
    "test:api": "npm run -w apps/api test",
    "test:apie2e": "npm run build:api && jest --config ./apps/api/test/jest-e2e.config.js",
    "test:gestion": "jest --config ./apps/gestion/jest.config.js -w apps/gestion",
    "cypress:open:gestion": "cypress open --project apps/gestion"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.0.0"
  }
}

{
  "name": "cuadrantes2-monorepo",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "cd api && npm run start:dev",
    "test": "echo \"Error: no test specified\" && exit 1",
    "api": "npm-run-all --parallel watch:shared dev:api",
    "gestion": "npm-run-all --parallel watch:shared dev:gestion",
    "build:shared": "npm run -w @cuadrantes/shared-dto build",
    "watch:shared": "npm run -w @cuadrantes/shared-dto watch",
    "dev:api": "npm run -w apps/api start:dev",
    "dev:gestion": "npm run -w apps/gestion dev",
    "test:api": "jest --config ./apps/api/jest.config.js",
    "test:gestion": "jest --config ./apps/gestion/jest.config.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.0.0"
  }
}

{
  "name": "cuadrantes2-monorepo",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel watch:shared dev:api dev:gestion",
    "dev:api": "npm run -w apps/api start:dev",
    "dev:gestion": "npm run -w apps/gestion dev",
    "build": "npm-run-all -s build:shared build:api build:gestion",
    "build:shared": "npm run -w @cuadrantes/shared-dto build",
    "build:api": "npm run -w apps/api build",
    "build:gestion": "npm run -w apps/gestion build",
    "watch:shared": "npm run -w @cuadrantes/shared-dto watch",
    "start:api": "npm run start:prod -w apps/api",
    "start:gestion": "npm run -w apps/gestion start",
    "test:api": "npm run -w apps/api test",
    "test:e2e:api": "cross-env NODE_ENV=test npm run build:api && NODE_ENV=test jest --config ./apps/api/test/jest-e2e.config.js --forceExit",
    "test:gestion": "jest --config ./apps/gestion/jest.config.js -w ./apps/gestion",
    "cypress:open:gestion": "cypress open --project apps/gestion",
    "storybook:gestion": "npm run storybook -w apps/gestion",
    "build-storybook:gestion": "npm run build-storybook -w apps/gestion",
    "db:seed:e2e": "npm run db:seed --workspace=apps/api",
    "start:api:e2e": "cross-env NODE_ENV=test nest start --watch api",
    "start:gestion:e2e": "npm run dev --workspace=apps/gestion",
    "test:e2e:gestion": "npm run db:seed:e2e && concurrently --kill-others --success first \"npm:start:api:e2e\" \"npm:start:gestion:e2e\" \"npm:cy:open\"",
    "cy:open": "cypress open --e2e --browser chrome --project ./apps/gestion"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.0.0"
  }
}
